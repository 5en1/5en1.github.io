---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="Contact - 5 en 1" lang="en">
  <Header />
  <main class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-brand-950 mb-6">Contact</h1>
      <p class="text-neutral-700 mb-8">
        You can get in touch with us through our social media channels or by email.
      </p>
      <div class="space-y-4">
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Email</h2>
          <a href="mailto:info@5en1.club" class="text-brand-700 hover:underline">info@5en1.club</a>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Instagram</h2>
          <a href="https://instagram.com/5en1club" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">@5en1club</a>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Facebook</h2>
          <a href="https://facebook.com/5en1club" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">5en1club</a>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Twitter</h2>
          <a href="https://twitter.com/5en1club" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">@5en1club</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
