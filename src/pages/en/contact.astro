---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="Contact - 5 en 1" lang="en">
  <Header />
  <main class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-brand-950 mb-6">Contact</h1>
      <p class="text-neutral-700 mb-2">
        You can get in touch with us through our social media channels or by email.
      </p>
      <p class="text-neutral-500 mb-8">
        Contact details will be published soon.
      </p>
      <div class="space-y-4">
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Email</h2>
          <span class="text-neutral-500">TBD</span>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Instagram</h2>
          <span class="text-neutral-500">TBD</span>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Facebook</h2>
          <span class="text-neutral-500">TBD</span>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Twitter</h2>
          <span class="text-neutral-500">TBD</span>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
