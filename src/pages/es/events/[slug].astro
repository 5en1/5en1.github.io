---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }: any) => data.locale === 'es' && !data.draft);
  return events.map((event: any) => {
    let sid = event.id;
    if (sid.endsWith(".md")) sid = sid.slice(0, -3);
    const slug = sid.split("/").pop() || event.id;
    return {
      params: { slug },
      props: { event },
    };
  });
}

interface Props {
  event: CollectionEntry<'events'>;
}
const { event } = Astro.props;
const { Content } = await render(event);
const typeLabels = {
  competition: 'Competición',
  camp: 'Campamento',
  other: 'Otro',
};
---
<BaseLayout title={`${event.data.title} - Eventos 5 en 1`} lang="es">
  <Header />
  <main class="py-12 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <article>
        <header class="mb-8">
          <h1 class="text-3xl font-bold text-brand-950 mb-4">{event.data.title}</h1>
          <div class="space-y-2 text-neutral-700">
            <p><span class="font-medium">Fecha:</span> {event.data.startDate.toLocaleDateString('es-ES')}</p>
            <p><span class="font-medium">Lugar:</span> {event.data.location}</p>
            <p><span class="font-medium">Tipo:</span> {typeLabels[event.data.type as keyof typeof typeLabels]}</p>
            {event.data.registrationLink && (
              <p>
                <span class="font-medium">Inscripción:</span> 
                <a href={event.data.registrationLink} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">
                  Más información
                </a>
              </p>
            )}
          </div>
        </header>
        <div class="prose prose-neutral max-w-none prose-headings:text-brand-950 prose-a:text-brand-700 prose-a:no-underline hover:prose-a:underline prose-strong:text-brand-950">
          <Content />
        </div>
      </article>
      <div class="mt-12">
        <a href="/es/events" class="text-brand-700 hover:underline">← Volver a eventos</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
