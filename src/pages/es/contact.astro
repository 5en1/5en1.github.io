---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="Contacto - 5 en 1" lang="es">
  <Header />
  <main class="py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold text-brand-950 mb-6">Contacto</h1>
      <p class="text-neutral-700 mb-2">
        Puedes ponerte en contacto con nosotros a través de nuestras redes sociales o por correo electrónico.
      </p>
      <p class="text-neutral-500 mb-8">
        Los datos de contacto se publicarán próximamente.
      </p>
      <div class="space-y-4">
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Correo electrónico</h2>
          <span class="text-neutral-500">TBD</span>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Instagram</h2>
          <span class="text-neutral-500">TBD</span>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Facebook</h2>
          <span class="text-neutral-500">TBD</span>
        </div>
        <div class="bg-white border border-neutral-200 rounded-lg p-4">
          <h2 class="font-semibold text-brand-950 mb-2">Twitter</h2>
          <span class="text-neutral-500">TBD</span>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
