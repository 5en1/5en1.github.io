---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: any) => data.locale === 'es' && !data.draft);
  return posts.map((post: any) => {
    let sid = post.id;
    if (sid.endsWith(".md")) sid = sid.slice(0, -3);
    const slug = sid.split("/").pop() || post.id;
    return {
      params: { slug },
      props: { post },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content } = await render(post);

const tagLabels: Record<string, string> = {
  competitions: 'Competiciones',
  trainings: 'Entrenamientos',
  club: 'Club',
  news: 'Noticias',
};
---
<BaseLayout title={`${post.data.title} - Blog 5 en 1`} lang="es">
  <Header />
  <main class="py-12 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <article>
        <header class="mb-8">
          <h1 class="text-3xl font-bold text-brand-950 mb-4">{post.data.title}</h1>
          <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-600">
            <span>{post.data.pubDate.toLocaleDateString('es-ES')}</span>
            {post.data.author && <span>Por {post.data.author}</span>}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex gap-2">
                {post.data.tags.map((tag: any) => (
                  <span class="bg-brand-100 text-brand-800 px-2 py-1 rounded-full text-xs">
                    {tagLabels[tag as keyof typeof tagLabels] || tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </header>
        <div class="prose prose-neutral max-w-none prose-headings:text-brand-950 prose-a:text-brand-700 prose-a:no-underline hover:prose-a:underline prose-strong:text-brand-950">
          <Content />
        </div>
      </article>
      <div class="mt-12">
        <a href="/es/blog" class="text-brand-700 hover:underline">← Volver al blog</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
