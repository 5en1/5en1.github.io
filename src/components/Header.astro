---
const currentPath = Astro.url.pathname;
const isEN = currentPath.startsWith('/en');
const isES = !isEN;
const baseES = '/es';
const baseEN = '/en';

const linksES = [
  { href: `${baseES}/`, label: 'Inicio' },
  { href: `${baseES}/about`, label: 'Nosotros' },
  { href: `${baseES}/events`, label: 'Eventos' },
  { href: `${baseES}/blog`, label: 'Blog' },
  { href: `${baseES}/contact`, label: 'Contacto' },
];
const linksEN = [
  { href: `${baseEN}/`, label: 'Home' },
  { href: `${baseEN}/about`, label: 'About' },
  { href: `${baseEN}/events`, label: 'Events' },
  { href: `${baseEN}/blog`, label: 'Blog' },
  { href: `${baseEN}/contact`, label: 'Contact' },
];
const links = isEN ? linksEN : linksES;

const isActive = (href: string) =>
  currentPath === href ||
  (href !== `${baseES}/` && href !== `${baseEN}/` && currentPath.startsWith(href));

const switchEs = currentPath.replace(/^\/en/, '/es') || '/es/';
const switchEn = currentPath.replace(/^\/es/, '/en') || '/en/';
---
<header class="bg-white border-b border-neutral-200 sticky top-0 z-10 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex items-center min-w-0">
        <a href={isEN ? '/en/' : '/es/'} class="flex-shrink-0 font-bold text-xl text-brand-950 hover:text-brand-600">
          5 en 1
        </a>
        <span class="ml-3 text-xs sm:text-sm text-neutral-500 hidden lg:block">
          {isEN ? 'Modern Pentathlon Club' : 'Club de Pentatlón Moderno'}
        </span>
      </div>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center space-x-4 sm:space-x-6">
        {links.map(link => (
          <a
            href={link.href}
            class={`text-sm font-medium transition-colors hover:text-brand-600 ${isActive(link.href) ? 'text-brand-700 border-b-2 border-accent-600 pb-1' : 'text-neutral-700'}`}
          >
            {link.label}
          </a>
        ))}
        <div class="border-l border-neutral-200 pl-4 flex items-center space-x-2">
          <a
            href={switchEs}
            class={`text-xs px-2 py-1 rounded ${isES ? 'bg-brand-100 text-brand-900' : 'text-neutral-600 hover:text-brand-600'}`}
          >
            ES
          </a>
          <a
            href={switchEn}
            class={`text-xs px-2 py-1 rounded ${isEN ? 'bg-brand-100 text-brand-900' : 'text-neutral-600 hover:text-brand-600'}`}
          >
            EN
          </a>
        </div>
      </nav>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded text-neutral-700 hover:text-brand-600 hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={isEN ? 'Open menu' : 'Abrir menú'}
        data-label-open={isEN ? 'Open menu' : 'Abrir menú'}
        data-label-close={isEN ? 'Close menu' : 'Cerrar menú'}
      >
        <svg id="icon-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="h-6 w-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-200 bg-white">
    <nav class="px-4 py-3 space-y-1">
      {links.map(link => (
        <a
          href={link.href}
          class={`block px-3 py-2 rounded text-sm font-medium ${isActive(link.href) ? 'bg-brand-50 text-brand-700' : 'text-neutral-700 hover:bg-neutral-100'}`}
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center space-x-2 px-3 pt-3 mt-2 border-t border-neutral-200">
        <a
          href={switchEs}
          class={`text-xs px-2 py-1 rounded ${isES ? 'bg-brand-100 text-brand-900' : 'text-neutral-600 hover:text-brand-600'}`}
        >
          ES
        </a>
        <a
          href={switchEn}
          class={`text-xs px-2 py-1 rounded ${isEN ? 'bg-brand-100 text-brand-900' : 'text-neutral-600 hover:text-brand-600'}`}
        >
          EN
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute(
      'aria-label',
      isOpen ? (toggle.dataset.labelClose ?? 'Cerrar menú') : (toggle.dataset.labelOpen ?? 'Abrir menú'),
    );
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
