---
const currentPath = Astro.url.pathname;
const isES = currentPath.startsWith('/es') || currentPath === '/' || (!currentPath.startsWith('/en') && currentPath !== '/');
const isEN = currentPath.startsWith('/en');
const baseES = '/es';
const baseEN = '/en';

const linksES = [
  { href: `${baseES}/`, label: 'Inicio' },
  { href: `${baseES}/about`, label: 'Nosotros' },
  { href: `${baseES}/events`, label: 'Eventos' },
  { href: `${baseES}/blog`, label: 'Blog' },
  { href: `${baseES}/contact`, label: 'Contacto' },
];
const linksEN = [
  { href: `${baseEN}/`, label: 'Home' },
  { href: `${baseEN}/about`, label: 'About' },
  { href: `${baseEN}/events`, label: 'Events' },
  { href: `${baseEN}/blog`, label: 'Blog' },
  { href: `${baseEN}/contact`, label: 'Contact' },
];
const links = isEN ? linksEN : linksES;
---
<header class="bg-white border-b border-neutral-200 sticky top-0 z-10 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <div class="flex items-center">
        <a href={isEN ? '/en/' : '/es/'} class="flex-shrink-0 font-bold text-xl text-brand-950 hover:text-brand-600">
          5 en 1
        </a>
        <span class="ml-3 text-xs sm:text-sm text-neutral-500 hidden sm:block">
          {isEN ? 'Modern Pentathlon Club' : 'Club de Pentatlón Moderno'}
        </span>
      </div>
      <nav class="flex items-center space-x-4 sm:space-x-6">
        {links.map(link => (
          <a
            href={link.href}
            class={`text-sm font-medium transition-colors hover:text-brand-600 ${currentPath === link.href || (link.href !== `${baseES}/` && link.href !== `${baseEN}/` && currentPath.startsWith(link.href)) ? 'text-brand-700 border-b-2 border-accent-600 pb-1' : 'text-neutral-700'}`}
          >
            {link.label}
          </a>
        ))}
        <div class="border-l border-neutral-200 pl-4 flex items-center space-x-2">
          <a
            href={currentPath.replace(/^\/en/, '/es') || '/es/'}
            class={`text-xs px-2 py-1 rounded ${isES ? 'bg-brand-100 text-brand-900' : 'text-neutral-600 hover:text-brand-600'}`}
          >
            ES
          </a>
          <a
            href={currentPath.replace(/^\/es/, '/en') || '/en/'}
            class={`text-xs px-2 py-1 rounded ${isEN ? 'bg-brand-100 text-brand-900' : 'text-neutral-600 hover:text-brand-600'}`}
          >
            EN
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>
