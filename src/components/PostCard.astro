---
export interface Props {
  title: string;
  pubDate: Date;
  description?: string;
  href: string;
  tags?: string[];
}
const { title, pubDate, description, href, tags = [] } = Astro.props;
const isEN = Astro.url.pathname.startsWith('/en');
const tagLabels: Record<string, string> = {
  competitions: isEN ? 'Competitions' : 'Competiciones',
  trainings: isEN ? 'Trainings' : 'Entrenamientos',
  club: isEN ? 'Club' : 'Club',
  news: isEN ? 'News' : 'Noticias',
};
---
<article class="bg-white border border-neutral-200 rounded-lg p-4 hover:shadow-md transition-shadow">
  <h3 class="text-lg font-semibold text-brand-950 mb-2">
    <a href={href} class="hover:underline">{title}</a>
  </h3>
  <p class="text-sm text-neutral-500 mb-2">
    {pubDate.toLocaleDateString(isEN ? 'en-US' : 'es-ES')}
  </p>
  {description && <p class="text-neutral-700 mb-3">{description}</p>}
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map(tag => (
        <span class="bg-brand-100 text-brand-900 text-xs px-2 py-1 rounded-full">
          {tagLabels[tag] || tag}
        </span>
      ))}
    </div>
  )}
</article>
