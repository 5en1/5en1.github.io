---
export interface Props {
  title: string;
  startDate: Date;
  location: string;
  type: 'competition' | 'camp' | 'other';
  href?: string;
  description?: string;
}
const { title, startDate, location, type, href, description } = Astro.props;
const typeColors = {
  competition: 'bg-accent-100 text-accent-700',
  camp: 'bg-brand-100 text-brand-800',
  other: 'bg-neutral-100 text-neutral-700',
};
const typeLabels = {
  competition: Astro.url.pathname.startsWith('/en') ? 'Competition' : 'Competición',
  camp: Astro.url.pathname.startsWith('/en') ? 'Camp' : 'Campamento',
  other: Astro.url.pathname.startsWith('/en') ? 'Other' : 'Otro',
};
---
<article class="bg-white border border-neutral-200 rounded-lg p-4 hover:shadow-md transition-shadow">
  <div class="flex justify-between items-start mb-2">
    <h3 class="text-lg font-semibold text-brand-900">
      {href ? <a href={href} class="hover:underline">{title}</a> : title}
    </h3>
    <span class={`px-2 py-1 text-xs rounded-full ${typeColors[type]}`}>
      {typeLabels[type]}
    </span>
  </div>
  <div class="text-sm text-neutral-600 space-y-1">
    <p><span class="font-medium">{Astro.url.pathname.startsWith('/en') ? 'Date:' : 'Fecha:'}</span> {startDate.toLocaleDateString(Astro.url.pathname.startsWith('/en') ? 'en-US' : 'es-ES')}</p>
    <p><span class="font-medium">{Astro.url.pathname.startsWith('/en') ? 'Location:' : 'Lugar:'}</span> {location}</p>
    {description && <p class="text-neutral-700 mt-2">{description}</p>}
  </div>
  {href && (
    <a href={href} class="mt-3 inline-block text-sm text-brand-700 hover:underline">
      {Astro.url.pathname.startsWith('/en') ? 'View details' : 'Ver detalles'} →
    </a>
  )}
</article>
